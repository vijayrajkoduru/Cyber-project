cd ~/Cyber-project

# Generate a random JWT secret
JWT=$(openssl rand -hex 32)

# Append the three env vars to .env (don't overwrite existing keys)
cat >> .env <<EOF
JWT_SECRET=$JWT
ADMIN_PASSWORD=CyberAdmin@2025
CORS_ORIGINS=https://app.vulnuslab.com,https://vulnuslab.com
EOF

# Pick a real admin password before continuing — edit if needed
nano .env

# Pull, rebuild, restart
git pull
docker compose build --no-cache backend frontend
docker compose up -d

# Watch backend logs to confirm it started
docker compose logs -f backend
