# VulnusLab environment template — copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# ── Required ────────────────────────────────────────────────────────
# JWT signing secret. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# PostgreSQL connection (full cutover — required).
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg2://vluser:CHANGE_ME@postgres:5432/vulnuslab

# ── Strongly recommended in production ──────────────────────────────
# Comma-separated allowed frontend origins. NEVER use "*".
# e.g. https://app.vulnuslab.com,https://vulnuslab.com
CORS_ORIGINS=

# Seeds the ADMIN superadmin on first boot. Leave blank to skip seeding.
ADMIN_PASSWORD=

# Postgres password (used by docker-compose for the postgres service).
POSTGRES_PASSWORD=CHANGE_ME

# ── Error monitoring (optional but recommended) ─────────────────────
# Paste the DSN from your Sentry project to get alerted on backend 500s.
# Leave blank to disable (the app runs fine without it).
SENTRY_DSN=
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.0   # 0 = errors only (cheapest); raise for perf tracing

# ── Optional tuning (sane defaults exist) ───────────────────────────
# Auth re-validation cache TTL in seconds (0 = always hit DB).
# VL_AUTH_CACHE_TTL=15
# Per-plan daily scan caps.
# QUOTA_TRIAL_PER_DAY=5
# QUOTA_PRO_PER_DAY=200
# QUOTA_TEAM_PER_DAY=1000
# Trial length in days.
# TRIAL_DAYS=7
# Global request rate limit (requests per window per client).
# RATE_LIMIT_PER_MIN=120
# DB connection pool sizing.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Shared secret stamped on internal orchestrator fan-out calls.
# VL_INTERNAL_FANOUT_TOKEN=change-me-internal
