FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY public ./public
COPY src ./src
# CI=false tells react-scripts to NOT treat warnings as errors. Without this,
# Docker's non-TTY stdout makes CRA auto-detect "CI mode" and reject the build
# on any legacy unused-var / no-mixed-operators warning. We have those in
# App.js (9k+ lines, accumulated over time) — fixing them all is a separate
# cleanup pass. For now, warnings are still printed but don't fail the build.
RUN CI=false npm run build

FROM nginx:alpine
COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN chmod -R 755 /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
