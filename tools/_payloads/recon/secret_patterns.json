{
  "patterns": [
    {
      "name": "AWS Access Key",
      "regex": "AKIA[0-9A-Z]{16}",
      "severity": "HIGH"
    },
    {
      "name": "AWS Secret Key (context-anchored)",
      "regex": "(?i)aws[_-]?secret[_-]?(?:access[_-]?)?key[\\s\\\"'=:]{1,5}[A-Za-z0-9/+=]{40}",
      "severity": "HIGH"
    },
    {
      "name": "GitHub PAT",
      "regex": "ghp_[A-Za-z0-9]{36}",
      "severity": "CRITICAL"
    },
    {
      "name": "GitHub OAuth",
      "regex": "gho_[A-Za-z0-9]{36}",
      "severity": "CRITICAL"
    },
    {
      "name": "GitHub App Token",
      "regex": "ghs_[A-Za-z0-9]{36}",
      "severity": "CRITICAL"
    },
    {
      "name": "Slack Bot Token",
      "regex": "xoxb-[0-9]{10,}-[0-9]{10,}-[A-Za-z0-9]{20,}",
      "severity": "HIGH"
    },
    {
      "name": "Slack Webhook",
      "regex": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+",
      "severity": "HIGH"
    },
    {
      "name": "Stripe Live Key",
      "regex": "sk_live_[A-Za-z0-9]{24,}",
      "severity": "CRITICAL"
    },
    {
      "name": "Stripe Test Key",
      "regex": "sk_test_[A-Za-z0-9]{24,}",
      "severity": "MEDIUM"
    },
    {
      "name": "Google API Key",
      "regex": "AIza[A-Za-z0-9_-]{35}",
      "severity": "HIGH"
    },
    {
      "name": "Twilio API Key",
      "regex": "SK[a-f0-9]{32}",
      "severity": "HIGH"
    },
    {
      "name": "SendGrid API",
      "regex": "SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}",
      "severity": "HIGH"
    },
    {
      "name": "Mailgun API",
      "regex": "key-[a-z0-9]{32}",
      "severity": "MEDIUM"
    },
    {
      "name": "Heroku API",
      "regex": "[h|H][e|E][r|R][o|O][k|K][u|U].*[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}",
      "severity": "HIGH"
    },
    {
      "name": "Generic JWT",
      "regex": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
      "severity": "MEDIUM"
    },
    {
      "name": "Private SSH Key",
      "regex": "-----BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY",
      "severity": "CRITICAL"
    },
    {
      "name": "Generic API Key",
      "regex": "[aA][pP][iI][_-]?[kK][eE][yY].{0,5}[\"'][A-Za-z0-9]{32,}",
      "severity": "MEDIUM"
    }
  ]
}