{
  "_note": "Keyword fragments + literal regexes used to flag PII handling/logging. Keyword fragments are matched case-insensitively as substrings near log/IO sinks; literal regexes match raw values. Credit-card / SSN patterns are advisory: match alone is low-confidence and must be corroborated by context (do NOT raise severity on a bare numeric match).",
  "keywords": [
    "email",
    "e-mail",
    "phone",
    "mobile_number",
    "msisdn",
    "imei",
    "imsi",
    "idfa",
    "gaid",
    "aaid",
    "advertising_id",
    "ssn",
    "social_security",
    "passport",
    "national_id",
    "aadhaar",
    "pan_number",
    "tax_id",
    "credit_card",
    "card_number",
    "cvv",
    "iban",
    "address",
    "geolocation",
    "latitude",
    "longitude",
    "userid",
    "date_of_birth",
    "dob",
    "first_name",
    "last_name",
    "full_name",
    "mac_address",
    "fingerprint",
    "biometric"
  ],
  "regexes": {
    "Email address": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
    "Phone (E.164)": "\\+[1-9]\\d{7,14}\\b",
    "US SSN": "\\b(?!000|666|9\\d\\d)\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b",
    "Credit card (Visa)": "\\b4[0-9]{12}(?:[0-9]{3})?\\b",
    "Credit card (Mastercard)": "\\b(?:5[1-5][0-9]{14}|2(?:22[1-9]|2[3-9][0-9]|[3-6][0-9]{2}|7[01][0-9]|720)[0-9]{12})\\b",
    "Credit card (Amex)": "\\b3[47][0-9]{13}\\b",
    "Credit card (Discover)": "\\b6(?:011|5[0-9]{2})[0-9]{12}\\b",
    "IBAN": "\\b[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}\\b",
    "IMEI": "\\b(?:35|86|01)[0-9]{12,13}\\b",
    "IDFA / GAID (UUID)": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b",
    "MAC address": "\\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\\b",
    "Indian Aadhaar": "(?<![0-9A-Fa-f-])[2-9][0-9]{3}\\s[0-9]{4}\\s[0-9]{4}(?![0-9A-Fa-f-])",
    "US Passport": "\\b[0-9]{9}\\b",
    "IPv4 (geo/PII context)": "\\b(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}\\b"
  }
}