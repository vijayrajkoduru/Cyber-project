    {"name": "Cloudflare Global API Key (legacy)", "regex": "(?i)cloudflare[_-]?(?:global[_-]?)?api[_-]?key[\\s\"'=:]{1,5}[a-f0-9]{37}", "severity": "CRITICAL", "category": "cdn-cloudflare", "context_required": true},
