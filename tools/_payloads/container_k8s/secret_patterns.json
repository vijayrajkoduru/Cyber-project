    {"name": "Datadog API Key", "regex": "(?i)datadog[_-]?api[_-]?key[\\s\"'=:]{1,5}[a-f0-9]{32}", "severity": "HIGH", "category": "monitoring-datadog", "context_required": true},
    {"name": "Datadog Application Key", "regex": "(?i)dd[_-]?(?:app|application)[_-]?key[\\s\"'=:]{1,5}[a-f0-9]{40}", "severity": "HIGH", "category": "monitoring-datadog", "context_required": true},
    {"name": "New Relic License Key", "regex": "(?i)new[_-]?relic[_-]?(?:license|key)[\\s\"'=:]{1,5}[A-Za-z0-9]{40}", "severity": "HIGH", "category": "monitoring-newrelic", "context_required": true},
    {"name": "New Relic User API Key", "regex": "NRAK-[A-Z0-9]{27}", "severity": "HIGH", "category": "monitoring-newrelic"},
    {"name": "New Relic REST API Key", "regex": "NRRA-[a-f0-9]{42}", "severity": "HIGH", "category": "monitoring-newrelic"},
    {"name": "Sentry DSN (with secret)", "regex": "https://[a-f0-9]{32}:[a-f0-9]{32}@(?:o[0-9]+\\.ingest\\.)?sentry\\.io/[0-9]+", "severity": "MEDIUM", "category": "monitoring-sentry"},
    {"name": "Sentry Auth Token", "regex": "sntrys_[A-Za-z0-9_=]{64}", "severity": "HIGH", "category": "monitoring-sentry"},
    {"name": "PagerDuty API Token", "regex": "(?i)pagerduty[_-]?(?:api[_-]?)?token[\\s\"'=:]{1,5}[A-Za-z0-9_-]{20}", "severity": "HIGH", "category": "monitoring-pagerduty", "context_required": true},
    {"name": "Honeybadger API Key", "regex": "(?i)honeybadger[_-]?api[_-]?key[\\s\"'=:]{1,5}[a-f0-9]{8}", "severity": "MEDIUM", "category": "monitoring-honeybadger", "context_required": true},
    {"name": "Rollbar Access Token", "regex": "(?i)rollbar[_-]?(?:access[_-]?)?token[\\s\"'=:]{1,5}[a-f0-9]{32}", "severity": "HIGH", "category": "monitoring-rollbar", "context_required": true},
    {"name": "Bugsnag API Key", "regex": "(?i)bugsnag[_-]?api[_-]?key[\\s\"'=:]{1,5}[a-f0-9]{32}", "severity": "HIGH", "category": "monitoring-bugsnag", "context_required": true},

    {"name": "npm Access Token", "regex": "npm_[A-Za-z0-9]{36}", "severity": "CRITICAL", "category": "package-npm"},
    {"name": "Yarn Token", "regex": "(?i)yarn[_-]?(?:auth[_-]?)?token[\\s\"'=:]{1,5}[A-Fa-f0-9]{32,}", "severity": "HIGH", "category": "package-yarn", "context_required": true},
    {"name": "PyPI Upload Token", "regex": "pypi-[A-Za-z0-9_-]{50,}", "severity": "CRITICAL", "category": "package-pypi"},
