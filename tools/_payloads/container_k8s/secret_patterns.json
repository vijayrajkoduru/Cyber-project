    {"name": "Heroku API Key", "regex": "(?i)heroku[_-]?(?:api[_-]?)?key[\\s\"'=:]{1,5}[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "severity": "HIGH", "category": "paas-heroku", "context_required": true},
    {"name": "Netlify Personal Access Token", "regex": "(?i)netlify[_-]?(?:auth[_-]?)?token[\\s\"'=:]{1,5}nfp_[A-Za-z0-9_-]{40,}", "severity": "HIGH", "category": "paas-netlify", "context_required": true},
    {"name": "Vercel Access Token", "regex": "(?i)vercel[_-]?(?:api[_-]?)?(?:token|key)[\\s\"'=:]{1,5}[A-Za-z0-9]{24,}", "severity": "HIGH", "category": "paas-vercel", "context_required": true},
