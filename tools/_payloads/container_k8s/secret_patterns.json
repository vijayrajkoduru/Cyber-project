    {"name": "MySQL Connection String", "regex": "mysql://[^\\s:]+:[^@\\s]+@[^\\s/]+(?::[0-9]+)?/[^\\s?]+", "severity": "CRITICAL", "category": "db-connection"},
    {"name": "MongoDB Connection String", "regex": "mongodb(?:\\+srv)?://[^\\s:]+:[^@\\s]+@[^\\s/]+", "severity": "CRITICAL", "category": "db-connection"},
    {"name": "Redis Connection String with auth", "regex": "redis://[^\\s:@]*:[^@\\s]+@[^\\s/]+(?::[0-9]+)?", "severity": "CRITICAL", "category": "db-connection"},
    {"name": "MSSQL Connection String", "regex": "(?i)Server=[^;]+;Database=[^;]+;User Id=[^;]+;Password=[^;]+;", "severity": "CRITICAL", "category": "db-connection"},

    {"name": "Telegram Bot Token", "regex": "[0-9]{8,10}:[A-Za-z0-9_-]{35}", "severity": "HIGH", "category": "comms-telegram"},
    {"name": "LINE Channel Access Token", "regex": "(?i)line[_-]?(?:channel[_-]?)?(?:access[_-]?)?token[\\s\"'=:]{1,5}[A-Za-z0-9+/=]{170}", "severity": "HIGH", "category": "comms-line", "context_required": true},

    {"name": "Coinbase API Key", "regex": "(?i)coinbase[_-]?(?:api[_-]?)?key[\\s\"'=:]{1,5}[A-Za-z0-9]{32}", "severity": "CRITICAL", "category": "crypto-coinbase", "context_required": true},
    {"name": "Binance API Key", "regex": "(?i)binance[_-]?(?:api[_-]?)?key[\\s\"'=:]{1,5}[A-Za-z0-9]{64}", "severity": "CRITICAL", "category": "crypto-binance", "context_required": true},

    {"name": "Asymmetric Key Header in Env Block", "regex": "(?i)private[_-]?key[\\s\"'=:]{1,5}-----BEGIN", "severity": "CRITICAL", "category": "key-private", "context_required": true},
    {"name": "Base64-Encoded Private Key Hint", "regex": "(?i)base64.{0,20}(?:private|secret).{0,10}key", "severity": "MEDIUM", "category": "key-private", "context_required": true}
  ]
}
