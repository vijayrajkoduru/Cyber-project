{
  "_source": "Compiled from public sources: gitleaks (github.com/gitleaks/gitleaks/config/gitleaks.toml), trufflehog detectors, OWASP secrets-in-code cheatsheet. Last refresh: 2026-06-02. All patterns validated against the Recon false-positive corpus (webpack chunk hashes, base64 padding, etc.) before shipping.",
  "_notes": "Patterns marked context_required:true MUST match within 5 chars of a keyword anchor to fire (prevents 40-char-blob false positives like the AWS Secret Key FP we patched in commit 51df8d2a).",
  "patterns": [
    {"name": "AWS Access Key ID", "regex": "AKIA[0-9A-Z]{16}", "severity": "CRITICAL", "category": "cloud-aws"},
    {"name": "AWS Secret Access Key", "regex": "(?i)aws[_-]?(?:secret|sec)[_-]?(?:access[_-]?)?key[\\s\"'=:]{1,5}[A-Za-z0-9/+=]{40}", "severity": "CRITICAL", "category": "cloud-aws", "context_required": true},
    {"name": "AWS Session Token", "regex": "(?i)aws[_-]?session[_-]?token[\\s\"'=:]{1,5}[A-Za-z0-9/+=]{100,}", "severity": "HIGH", "category": "cloud-aws", "context_required": true},
    {"name": "AWS MWS Auth Token", "regex": "amzn\\.mws\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "severity": "HIGH", "category": "cloud-aws"},
    {"name": "AWS S3 URL with creds", "regex": "[A-Za-z0-9]{20}:[A-Za-z0-9+/]{40}@", "severity": "HIGH", "category": "cloud-aws"},

    {"name": "GCP API Key", "regex": "AIza[0-9A-Za-z_-]{35}", "severity": "HIGH", "category": "cloud-gcp"},
    {"name": "GCP Service Account Key (JSON privkey)", "regex": "\"type\"[\\s]*:[\\s]*\"service_account\"", "severity": "CRITICAL", "category": "cloud-gcp"},
    {"name": "GCP OAuth Client Secret", "regex": "(?i)client[_-]?secret[\\s\"'=:]{1,5}[A-Za-z0-9_-]{24}", "severity": "HIGH", "category": "cloud-gcp", "context_required": true},
    {"name": "GCP Service Account Private Key ID", "regex": "\"private_key_id\"[\\s]*:[\\s]*\"[0-9a-f]{40}\"", "severity": "CRITICAL", "category": "cloud-gcp"},

    {"name": "Azure Storage Account Key", "regex": "(?i)defaultendpointsprotocol=https;accountname=[a-z0-9]+;accountkey=[A-Za-z0-9+/=]{86,}", "severity": "CRITICAL", "category": "cloud-azure"},
    {"name": "Azure SAS Token", "regex": "(?i)sv=20\\d{2}-\\d{2}-\\d{2}&s[\\w]*=[A-Za-z0-9%+/=]+", "severity": "HIGH", "category": "cloud-azure"},
    {"name": "Azure Service Principal Secret", "regex": "(?i)azure[_-]?client[_-]?secret[\\s\"'=:]{1,5}[A-Za-z0-9._~-]{34,40}", "severity": "CRITICAL", "category": "cloud-azure", "context_required": true},
    {"name": "Azure Tenant ID Pattern", "regex": "(?i)azure[_-]?tenant[_-]?id[\\s\"'=:]{1,5}[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "severity": "MEDIUM", "category": "cloud-azure", "context_required": true},

    {"name": "DigitalOcean Personal Access Token", "regex": "dop_v1_[a-f0-9]{64}", "severity": "CRITICAL", "category": "cloud-do"},
    {"name": "DigitalOcean OAuth Refresh Token", "regex": "doo_v1_[a-f0-9]{64}", "severity": "HIGH", "category": "cloud-do"},
    {"name": "DigitalOcean OAuth Access Token", "regex": "dor_v1_[a-f0-9]{64}", "severity": "HIGH", "category": "cloud-do"},

    {"name": "Linode Personal Access Token", "regex": "(?i)linode[_-]?(?:api|token)[\\s\"'=:]{1,5}[a-f0-9]{64}", "severity": "HIGH", "category": "cloud-linode", "context_required": true},

    {"name": "GitHub Personal Access Token (classic)", "regex": "ghp_[A-Za-z0-9]{36,}", "severity": "CRITICAL", "category": "vcs-github"},
    {"name": "GitHub Personal Access Token (fine-grained)", "regex": "github_pat_[A-Za-z0-9_]{82}", "severity": "CRITICAL", "category": "vcs-github"},
    {"name": "GitHub OAuth Access Token", "regex": "gho_[A-Za-z0-9]{36}", "severity": "CRITICAL", "category": "vcs-github"},
    {"name": "GitHub App User Token (user-to-server)", "regex": "ghu_[A-Za-z0-9]{36}", "severity": "CRITICAL", "category": "vcs-github"},
    {"name": "GitHub App Installation Token (server-to-server)", "regex": "ghs_[A-Za-z0-9]{36}", "severity": "CRITICAL", "category": "vcs-github"},
    {"name": "GitHub Refresh Token", "regex": "ghr_[A-Za-z0-9]{36,255}", "severity": "HIGH", "category": "vcs-github"},
    {"name": "GitHub SSH Deploy Key", "regex": "(?:ssh-rsa|ssh-ed25519|ecdsa-sha2-nistp256) AAAA[A-Za-z0-9+/=]{100,}", "severity": "HIGH", "category": "vcs-github"},

    {"name": "GitLab Personal Access Token", "regex": "glpat-[A-Za-z0-9_-]{20}", "severity": "CRITICAL", "category": "vcs-gitlab"},
    {"name": "GitLab Pipeline Trigger Token", "regex": "glptt-[A-Za-z0-9_-]{40}", "severity": "HIGH", "category": "vcs-gitlab"},
    {"name": "GitLab Runner Registration Token", "regex": "GR1348941[A-Za-z0-9_-]{20}", "severity": "CRITICAL", "category": "vcs-gitlab"},
    {"name": "GitLab Feed Token", "regex": "glft-[A-Za-z0-9_-]{20}", "severity": "MEDIUM", "category": "vcs-gitlab"},
    {"name": "GitLab OAuth Application Secret", "regex": "(?i)gitlab[_-]?(?:oauth|app)[_-]?secret[\\s\"'=:]{1,5}gloas-[A-Za-z0-9_-]{64}", "severity": "HIGH", "category": "vcs-gitlab", "context_required": true},

    {"name": "Bitbucket OAuth Client Secret", "regex": "(?i)bitbucket[_-]?(?:client|oauth)[_-]?secret[\\s\"'=:]{1,5}[A-Za-z0-9_-]{32,}", "severity": "HIGH", "category": "vcs-bitbucket", "context_required": true},
    {"name": "Bitbucket App Password", "regex": "(?i)bitbucket[_-]?(?:app|api)[_-]?password[\\s\"'=:]{1,5}ATBB[A-Za-z0-9._-]{36,}", "severity": "CRITICAL", "category": "vcs-bitbucket", "context_required": true},

    {"name": "Slack Bot Token", "regex": "xoxb-[0-9]{10,13}-[0-9]{10,13}-[A-Za-z0-9]{24,}", "severity": "HIGH", "category": "comms-slack"},
    {"name": "Slack User Token", "regex": "xoxp-[0-9]{10,13}-[0-9]{10,13}-[0-9]{10,13}-[a-f0-9]{32}", "severity": "CRITICAL", "category": "comms-slack"},
    {"name": "Slack Workspace App Token", "regex": "xoxa-[0-9]-[0-9]{10,13}-[0-9]{10,13}-[A-Za-z0-9]{24,}", "severity": "HIGH", "category": "comms-slack"},
    {"name": "Slack Workspace Access Token", "regex": "xoxr-[0-9]+-[0-9]+-[A-Za-z0-9]{24,}", "severity": "HIGH", "category": "comms-slack"},
    {"name": "Slack Legacy Token", "regex": "xoxs-[0-9]+-[0-9]+-[0-9]+-[a-f0-9]{32}", "severity": "HIGH", "category": "comms-slack"},
    {"name": "Slack Webhook URL", "regex": "https://hooks\\.slack\\.com/services/T[A-Z0-9]{8,}/B[A-Z0-9]{8,}/[A-Za-z0-9]{24}", "severity": "HIGH", "category": "comms-slack"},

    {"name": "Discord Bot Token", "regex": "[MN][A-Za-z0-9]{23}\\.[A-Za-z0-9_-]{6}\\.[A-Za-z0-9_-]{27,}", "severity": "HIGH", "category": "comms-discord"},
    {"name": "Discord Webhook", "regex": "https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/[0-9]{17,20}/[A-Za-z0-9_-]{60,}", "severity": "MEDIUM", "category": "comms-discord"},

    {"name": "Microsoft Teams Webhook", "regex": "https://[a-z0-9-]+\\.webhook\\.office\\.com/webhookb2/[A-Fa-f0-9-]{36}@[A-Fa-f0-9-]{36}/IncomingWebhook/[a-f0-9]{32}/[A-Fa-f0-9-]{36}", "severity": "MEDIUM", "category": "comms-teams"},

    {"name": "Stripe Live Secret Key", "regex": "sk_live_[0-9a-zA-Z]{24,99}", "severity": "CRITICAL", "category": "payments-stripe"},
    {"name": "Stripe Test Secret Key", "regex": "sk_test_[0-9a-zA-Z]{24,99}", "severity": "MEDIUM", "category": "payments-stripe"},
