    {"name": "Stripe Publishable Key (info only)", "regex": "pk_(?:live|test)_[0-9a-zA-Z]{24,99}", "severity": "INFO", "category": "payments-stripe"},
    {"name": "Stripe Webhook Secret", "regex": "whsec_[A-Za-z0-9]{32,}", "severity": "HIGH", "category": "payments-stripe"},

    {"name": "PayPal Braintree Access Token", "regex": "access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-f]{32}", "severity": "CRITICAL", "category": "payments-paypal"},
    {"name": "Square Access Token", "regex": "sq0atp-[0-9A-Za-z_-]{22}", "severity": "CRITICAL", "category": "payments-square"},
    {"name": "Square OAuth Secret", "regex": "sq0csp-[0-9A-Za-z_-]{43}", "severity": "HIGH", "category": "payments-square"},

    {"name": "Twilio Account SID", "regex": "AC[a-f0-9]{32}", "severity": "MEDIUM", "category": "comms-twilio"},
    {"name": "Twilio Auth Token", "regex": "(?i)twilio[_-]?(?:auth[_-]?)?token[\\s\"'=:]{1,5}[a-f0-9]{32}", "severity": "HIGH", "category": "comms-twilio", "context_required": true},
    {"name": "Twilio API Key", "regex": "SK[a-f0-9]{32}", "severity": "HIGH", "category": "comms-twilio"},

    {"name": "SendGrid API Key", "regex": "SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}", "severity": "HIGH", "category": "email-sendgrid"},
    {"name": "Mailgun API Token", "regex": "key-[a-f0-9]{32}", "severity": "HIGH", "category": "email-mailgun"},
    {"name": "Mailgun Webhook Signing Key", "regex": "(?i)mailgun[_-]?signing[_-]?key[\\s\"'=:]{1,5}[a-h0-9]{32}-[a-h0-9]{8}-[a-h0-9]{8}", "severity": "MEDIUM", "category": "email-mailgun", "context_required": true},
    {"name": "Mailchimp API Key", "regex": "[0-9a-f]{32}-us[0-9]{1,2}", "severity": "HIGH", "category": "email-mailchimp"},
